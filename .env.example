MAILTRAP_USERNAME=your_mailtrap_username
MAILTRAP_PASSWORD=your_mailtrap_password
MAIL_FROM=noreply@your-domain.example

# Required outside local development
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long

# Optional application settings
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
REMINDERS_ENABLED=true
REMINDER_STALE_DAYS=7
REMINDER_SCAN_INTERVAL_MS=3600000
REMINDER_INITIAL_DELAY_MS=60000
